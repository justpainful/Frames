    "That operation was stopped before it finished." : {
      "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "توقفت العملية قبل أن تكتمل." } } }
    },
    "The export didn’t finish. Your edit is safe — try exporting again." : {
      "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يكتمل التصدير. تعديلك محفوظ — جرّب التصدير مرة أخرى." } } }
