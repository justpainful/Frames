    "The file couldn’t be read." : {
      "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّرت قراءة الملف." } } }
    },
    "The finished file couldn’t be added to your library. It’s still available to share." : {
      "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر إضافة الملف النهائي إلى مكتبتك. لا يزال بإمكانك مشاركته." } } }
    },
    "The preview couldn’t be drawn. Undo the last change and try again." : {
      "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر رسم المعاينة. تراجع عن آخر تغيير وحاول مجدداً." } } }
    },
    "The unsaved edit couldn’t be reopened, so it was discarded." : {
      "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر فتح التعديل غير المحفوظ، لذا تم تجاهله." } } }
    },
    "There isn’t enough free space on this iPhone to finish. Free up some space and try again." : {
      "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد مساحة كافية على هذا الـiPhone لإكمال العملية. أفرغ بعض المساحة وحاول مجدداً." } } }
    },
    "This file appears to be damaged and can’t be opened." : {
