    "That item couldn’t be brought into Frames. Try choosing it again." : {
      "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر إدخال هذا العنصر إلى Frames. جرّب اختياره مرة أخرى." } } }
